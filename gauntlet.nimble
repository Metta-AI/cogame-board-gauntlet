version     = "0.1.0"
author      = "daveey"
description = "Board Gauntlet: a rotating perfect-information ladder for the Softmax Coworld platform. Connect Four, Breakthrough, Hex and Quoridor; one game drawn per episode from the seed and announced to both seats; two cogs, zero sum, and a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
